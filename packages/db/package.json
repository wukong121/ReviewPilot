{
  "name": "@employee-review/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "preseed": "npm run generate",
    "seed": "prisma db seed --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.23.12",
    "vitest-mock-extended": "^5.1.1"
  },
  "dependencies": {
    "@employee-review/domain": "*",
    "@prisma/client": "^6.19.0"
  }
}
